<windows:BoundlessWindow x:Class="Boundless.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boundless.Desktop"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wpf1="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:userControls="clr-namespace:Boundless.Desktop.UserControls"
        xmlns:popups="clr-namespace:Boundless.Desktop.UserControls.Popups"
        xmlns:converters="clr-namespace:Boundless.Desktop.Utils.Converters"
        xmlns:viewModels="clr-namespace:Boundless.Desktop.ViewModels"
        xmlns:tabs="clr-namespace:Boundless.Desktop.UserControls.Tabs"
        xmlns:windows="clr-namespace:Boundless.Desktop.Windows"
        mc:Ignorable="d"
        Height="850" Width="1300"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        UseLayoutRounding="True"
        MinWidth="950"
        MinHeight="600"
        Title="Fortnite Account Manager"
        Style="{StaticResource MyBoundlessWindowStyle}"
        Loaded="MainWindow_OnLoaded">
    <Grid Background="#090f19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="330"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        
        <!-- Start sidebar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!-- Start account manager -->
            <Border Grid.Row="1" 
                    Margin="10 5" 
                    Background="#111729" 
                    CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="#202a47">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="ACCOUNTS"
                                   Foreground="#c9cddc"
                                   FontWeight="600"
                                   VerticalAlignment="Center"
                                   Margin="5 0"/>
                        <Button Grid.Column="2"
                                Width="30" 
                                Height="30" 
                                Padding="5"
                                Background="#111729"
                                BorderBrush="#202a47"
                                Click="AddAccount_OnClick">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Add24" Filled="True" Foreground="#2e5ecc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <!-- Account entries -->
                    <ScrollViewer Grid.Row="1" Margin="0 5 0 0">
                        <StackPanel Name="AccountsPanel">
                            <TextBlock Name="NoAccountsFoundTextBlock"
                                       Text="No accounts found." 
                                       Foreground="#919191" 
                                       Margin="0 8"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="2">
                        <Button Height="40"
                                Margin="5 0"
                                Padding="0 -10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#111729"
                                BorderBrush="#202a47"
                                BorderThickness="2"
                                Click="AddAccount_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Filled="True" Foreground="#2e5ecc" Margin="5"/>
                                <TextBlock Text="Add Account" Margin="5" Foreground="#2e5ecc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <!-- End account manager -->
            
            <!-- Start nav menu -->
            <Border Grid.Row="2" 
                    Margin="10 5" 
                    Background="#111729" 
                    CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="#202a47"
                    MinHeight="300">
                <Grid Margin="10">
                     <StackPanel Margin="10 5">
                         
                         <userControls:NavButton Content="Launch Fortnite" 
                                                 Symbol="Play24" 
                                                 Checked="LaunchFortnite_OnChecked" 
                                                 GroupName="LaunchFortnite"
                                                 x:Name="LaunchFortniteBtn"/>
                         <userControls:IconButton Content="Close Fortnite" 
                                                 Symbol="RecordStop24" 
                                                 x:Name="CloseFortniteBtn"
                                                 Click="CloseFortnite_MouseUp"
                                                 Visibility="Collapsed"/>
                        <userControls:NavButton Content="Cosmetics" 
                                                Symbol="Person24" 
                                                Checked="CosmeticsTab_OnChecked" 
                                                IsChecked="True"
                                                GroupName="Nav"/>
                        <userControls:NavButton Content="Swapper" 
                                                Symbol="Person24" 
                                                Checked="SwapperTab_OnChecked" 
                                                GroupName="Nav"/>
                        <userControls:NavButton Content="Lobby Bot" 
                                                Symbol="Person24" 
                                                Checked="SwapperTab_OnChecked" 
                                                GroupName="Nav"/>
                        <userControls:NavButton Content="Stats" 
                                                Symbol="DataBarVertical24" 
                                                Checked="SwapperTab_OnChecked" 
                                                GroupName="Nav"/>
                        
                        <userControls:NavButton Content="Settings" 
                                                Symbol="Settings24" 
                                                Checked="SwapperTab_OnChecked" 
                                                GroupName="Settings"/>
                        
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- End sidebar -->
        
        <!-- Start account -->
        <Border Grid.Row="0" 
                Grid.Column="1"
                Background="#111729" 
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="#202a47"
                Margin="5 5 10 5">
                <Grid>
                    <tabs:AccountCosmeticsTab x:Name="AccountCosmeticsTab" Visibility="Visible"/>
                    <tabs:SwapperTab x:Name="SwapperTab" Visibility="Collapsed"/>
                </Grid>
        </Border>
        <!-- End account -->
        
        <popups:PopupContainer Visibility="Collapsed"
                               Grid.Row="0" 
                               Grid.Column="0" 
                               Grid.RowSpan="2"
                               Grid.ColumnSpan="2"
                               x:Name="PopupContainer"/>
    </Grid>
</windows:BoundlessWindow>
