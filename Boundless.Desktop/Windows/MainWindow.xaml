<templates:BoundlessWindow x:Class="Boundless.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boundless.Desktop"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wpf1="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
        xmlns:templates="clr-namespace:Boundless.Desktop.Templates"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:userControls="clr-namespace:Boundless.Desktop.UserControls"
        mc:Ignorable="d"
        Height="700" Width="1150"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        UseLayoutRounding="True"
        MinWidth="750"
        MinHeight="500"
        Title="Boundless Launcher"
        Style="{StaticResource MyBoundlessWindowStyle}"
        Loaded="MainWindow_OnLoaded">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <LinearGradientBrush.Transform>
                    <RotateTransform Angle="45"/>
                </LinearGradientBrush.Transform>
                <LinearGradientBrush.GradientStops>
                    <GradientStop Color="#101226" Offset=".1"/>
                    <GradientStop Color="#160f24" Offset=".4"/>
                    <GradientStop Color="#1a0f24" Offset=".9"/>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
            <userControls:NavButton Label="News" Icon="News24" MouseUp="Library_OnClick" 
                                    Width="50" Height="50"
                                    Margin="0 5"/>
            <userControls:NavButton Label="Library" Icon="Games24" MouseUp="Library_OnClick" 
                                    Width="50" Height="50"
                                    Margin="0 5"/>
            <userControls:NavButton Label="Plugins" Icon="PlugConnected24" MouseUp="Library_OnClick" 
                                    Width="50" Height="50"
                                    Margin="0 5"/>
        </StackPanel>
            
        <Border Grid.Column="1"
                BorderThickness="1 0 0 0"
                BorderBrush="#969696"
            d:DataContext="{d:DesignInstance }">
            <StackPanel>
                <Grid Visibility="Visible">
                    <WrapPanel Margin="15">
                        <Grid Width="190" Height="240">
                            <Grid.OpacityMask>
                                <VisualBrush Visual="{Binding ElementName=Border1}" />
                            </Grid.OpacityMask>
                            
                            <Border Name="Border1" Background="#181b25" CornerRadius="6"></Border>
                            
                            <Grid>
                                <Image Source="/Images/Splash.bmp" HorizontalAlignment="Center"
                                       VerticalAlignment="Top" 
                                       Stretch="UniformToFill"/>
                            </Grid>
                            <Border Name="Border" Opacity="0">
                                <Border.Background>
                                    <SolidColorBrush Color="#000000" Opacity="0.85"/>
                                </Border.Background>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Border"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="0" To="1" Duration="0:0:.2"
                                                    FillBehavior="HoldEnd"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="Border"
                                                    Storyboard.TargetProperty="Opacity"
                                                    From="1" To="0" Duration="0:0:.2"
                                                    FillBehavior="HoldEnd"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <Button Width="100" Margin="0 5" 
                                            Background="#181b25"
                                            Padding="5 10"
                                            BorderBrush="#282f4a"
                                            BorderThickness="2">Launch</Button>
                                    <Button Width="100" Margin="0 5" 
                                            Background="#181b25"
                                            Padding="5 10"
                                            BorderBrush="#282f4a"
                                            BorderThickness="2">Menu</Button>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </WrapPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</templates:BoundlessWindow>
