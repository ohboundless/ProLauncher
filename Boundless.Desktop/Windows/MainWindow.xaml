<templates:BoundlessWindow x:Class="Boundless.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boundless.Desktop"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wpf1="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
        xmlns:templates="clr-namespace:Boundless.Desktop.Templates"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Boundless Launcher" Height="800" Width="1200"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="CanResize"
        WindowStyle="None"
        BorderThickness="1"
        UseLayoutRounding="True"
        MinWidth="750"
        MinHeight="500"
        Style="{StaticResource MyBoundlessWindowStyle}"
        Loaded="MainWindow_OnLoaded">
        <Grid>
                <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Background="#181b25">
                        <Border Padding="0 2">
                                <Border.Style>
                                        <Style TargetType="Border">
                                                <Setter Property="Background" Value="#181b25"></Setter>
                                                <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#111111"/>
                                                </Trigger>
                                                </Style.Triggers>
                                        </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" Margin="10">
                                        <ui:SymbolIcon Symbol="Games24" Foreground="White" FontSize="24"/>
                                        <TextBlock Text="Library" Margin="10 0" Foreground="White" FontSize="16"/>
                                </StackPanel>
                        </Border>
                </StackPanel>
        </Grid>
</templates:BoundlessWindow>
