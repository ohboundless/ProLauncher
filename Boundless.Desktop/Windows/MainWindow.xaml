<templates:BoundlessWindow x:Class="Boundless.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boundless.Desktop"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wpf1="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
        xmlns:templates="clr-namespace:Boundless.Desktop.Templates"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:userControls="clr-namespace:Boundless.Desktop.UserControls"
        mc:Ignorable="d"
        Height="850" Width="1300"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        UseLayoutRounding="True"
        MinWidth="950"
        MinHeight="600"
        Title="Fortnite Account Manager"
        Style="{StaticResource MyBoundlessWindowStyle}"
        Loaded="MainWindow_OnLoaded">
    <Grid Background="#090f19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="330"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        
        <!-- Start sidebar -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!-- Start account manager -->
            <Border Grid.Row="1" 
                    Margin="10 5" 
                    Background="#111729" 
                    CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="#202a47">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="ACCOUNTS"
                                   Foreground="#c9cddc"
                                   FontFamily="./Fonts/#Roboto" 
                                   FontWeight="600"
                                   VerticalAlignment="Center"
                                   Margin="5 0"/>
                        <Button Grid.Column="2" 
                                Width="30" 
                                Height="30" 
                                Padding="5"
                                Background="#111729"
                                BorderBrush="#202a47">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Add24" Filled="True" Foreground="#2e5ecc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <!-- Account entries -->
                    <ScrollViewer Grid.Row="1" Margin="0 5 0 0">
                        <StackPanel Name="AccountsPanel">
                            <TextBlock Name="NoAccountsFoundTextBlock"
                                       Text="No accounts found." 
                                       Foreground="#919191" 
                                       Margin="0 8"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="2">
                        <Button Height="40"
                                Margin="5 0"
                                Padding="0 -10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#111729"
                                BorderBrush="#202a47"
                                BorderThickness="2"
                                Click="AddAccount_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Filled="True" Foreground="#2e5ecc" Margin="5"/>
                                <TextBlock Text="Add Account" Margin="5" Foreground="#2e5ecc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <!-- End account manager -->
            
            <!-- Start nav menu -->
            <Border Grid.Row="2" 
                    Margin="10 5" 
                    Background="#111729" 
                    CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="#202a47"
                    MinHeight="300">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <userControls:NavButton Icon="PlayCircle28" Text="Launch Fortnite" Margin="0 3"
                                                Click="LaunchFortnite_OnClick"/>
                        <userControls:NavButton Icon="Person24" Text="Cosmetics" Margin="0 3" IsActive="True"/>
                        <userControls:NavButton Icon="DataBarVertical24" Text="Stats" Margin="0 3"/>
                        <userControls:NavButton Icon="Settings28" Text="Settings" Margin="0 3"/>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- End nav menu -->
        </Grid>
        <!-- End sidebar -->
        
        <!-- Start account -->
        <Border Grid.Row="0" 
                Grid.Column="1"
                Background="#111729" 
                CornerRadius="5"
                BorderThickness="1"
                BorderBrush="#202a47"
                Margin="5 5 10 5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150"/>
                        <RowDefinition Height="52"/>
                        <RowDefinition Height="75"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    
                    <!-- Start account details -->
                    <Grid Grid.Row="0" Margin="20 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Orientation="Horizontal"
                                    Grid.Column="0">
                            <Grid Width="110" Height="110">
                                <Border CornerRadius="8" Background="#222123" Name="Border1">
                                </Border>
                                <StackPanel>
                                    <Image
                                        Name="AccountIcon"
                                        Source="https://fortnite-api.com/images/cosmetics/br/character_sweetletter/smallicon.png"/>
                                    <StackPanel.OpacityMask>
                                        <VisualBrush Visual="{Binding ElementName=Border1}" />
                                    </StackPanel.OpacityMask>
                                </StackPanel>
                            </Grid>
                            
                            <StackPanel VerticalAlignment="Center" Margin="25">
                                <TextBlock x:Name="AccountUsername"
                                           Text="Account Username"
                                           Foreground="White"
                                           FontSize="20"
                                           FontWeight="Bold"/>
                                <TextBlock x:Name="EpicUsername"
                                           Text="Epic Games Username"
                                           Foreground="#b3b3b3"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Border Grid.Column="1"
                                Background="#05ffffff"
                                CornerRadius="5" Margin="10 25"
                                BorderBrush="#202a47"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                Width="Auto">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center" 
                                            Margin="20 0">
                                    <Image Source="pack://application:,,,/Images/Icons/T_UI_UniversalXP_Icon_LevelUp_Standard_256.png"
                                           Width="42"/>
                                    <StackPanel Margin="5 0" VerticalAlignment="Center">
                                        <TextBlock Text="Account Level" Foreground="#c9c9c9" FontSize="12"/>
                                        <TextBlock Name="AccountLevel" Text="1,784" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Border VerticalAlignment="Center" 
                                        BorderBrush="#202a47" 
                                        BorderThickness="1 0 0 0"
                                        Height="40"/>

                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center" 
                                            Margin="20 0">
                                    <Image Source="pack://application:,,,/Images/Icons/T_UI_Nexus_FigmentPass_L.png"
                                           Width="42"/>
                                    <StackPanel Margin="5 0" VerticalAlignment="Center">
                                        <TextBlock Text="Battle Pass" Foreground="#c9c9c9" FontSize="12"/>
                                        <TextBlock Name="BattlePassLevel" Text="Level 89" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <Border VerticalAlignment="Center" 
                                        BorderBrush="#202a47" 
                                        BorderThickness="1 0 0 0"
                                        Height="40"/>
                                
                                <StackPanel Orientation="Horizontal" 
                                            VerticalAlignment="Center" 
                                            Margin="20 0">
                                    <Image Source="pack://application:,,,/Images/Icons/T-VBuck-64.png"
                                           Width="42"/>
                                    <StackPanel Margin="5 0" VerticalAlignment="Center">
                                        <TextBlock Text="V-Bucks" Foreground="#c9c9c9" FontSize="12"/>
                                        <TextBlock Name="CurrencyQuantity" Text="2,750" Foreground="White" FontSize="15" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <!-- End account details -->
                    <Border Grid.Row="1" VerticalAlignment="Top" BorderBrush="#202a47" BorderThickness="0 1 0 0"/>
                    
                    <!-- Cosmetic tab buttons -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20 0" Name="TopBar">
                        <StackPanel.Resources>
                            <ControlTemplate x:Key="topBarRadioButton" TargetType="RadioButton">
                                <Border x:Name="border" BorderThickness="0 0 0 3"
                                        Height="47"
                                        Margin="0 5 0 0"
                                        Padding="20 0"
                                        Background="Transparent">
                                    <TextBlock x:Name="textBlock" 
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="#c9cddc"
                                               FontFamily="./Fonts/#Roboto" 
                                               FontSize="16"
                                               FontWeight="600">
                                        <ContentPresenter/>
                                    </TextBlock>
                                </Border>               
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="BorderBrush" TargetName="border" Value="#3a4377"></Setter>
                                        <Setter Property="Foreground" TargetName="textBlock" Value="#3a4377"></Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </StackPanel.Resources>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked" IsChecked="True">COSMETICS</RadioButton>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked">OUTFITS</RadioButton>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked">BACKBLINGS</RadioButton>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked">PICKAXES</RadioButton>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked">EMOTES</RadioButton>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked">GLIDERS</RadioButton>
                        <RadioButton Template="{StaticResource topBarRadioButton}" 
                                     Checked="TopBarRadioButton_OnChecked">WRAPS</RadioButton>
                        <!--TODO <RadioButton Template="{StaticResource topBarRadioButton}">MORE</RadioButton>-->
                    </StackPanel>
                    
                    <Border Grid.Row="2" VerticalAlignment="Top" BorderBrush="#202a47" BorderThickness="0 1 0 0"/>
                    
                    <!-- Search bar, filter, and sorting -->
                    <Border Grid.Row="2" Background="#0f000000">
                        <StackPanel Orientation="Horizontal" Margin="20 10" VerticalAlignment="Center">
                            <!--TODO FIX TEXTBOX FOCUS STYLE-->
                            <ui:TextBox PlaceholderText="Search cosmetics..." 
                                        Width="265" BorderBrush="#202a47" 
                                        BorderThickness="1"
                                        Background="#0affffff"
                                        FocusVisualStyle="{x:Null}"
                                        IconPlacement="Right">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Search24"/>
                                </ui:TextBox.Icon>
                            </ui:TextBox>
                            
                            <Button Height="40" Padding="10 0" Margin="10 0">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Filter24"/>
                                    <TextBlock Margin="5 0 0 0"
                                               FontFamily="./Fonts/#Roboto" 
                                               FontSize="14"
                                               FontWeight="600">Filter</TextBlock>
                                </StackPanel>
                            </Button>
                            
                            <ComboBox Height="40" ItemsSource="{Binding MyStringList}" 
                                      ItemStringFormat="Prefix: {0}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Sort: " Foreground="White" />
                                            <TextBlock Text="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                                
                                <ComboBoxItem Content="Default" 
                                              IsSelected="True"/>
                                <ComboBoxItem Content="Name"/>
                                <ComboBoxItem Content="Rarity"/>
                                <ComboBoxItem Content="Date Added"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>
                        
                    <Border Grid.Row="3" VerticalAlignment="Top" BorderBrush="#202a47" BorderThickness="0 1 0 0"/>
                    
                    <!-- Cosmetic tab panels -->
                    <ScrollViewer Grid.Row="3" Margin="15 10">
                        <StackPanel Name="Tabs">
                            <userControls:CosmeticTab x:Name="Cosmetics" Visibility="Visible"/>
                            <userControls:CosmeticTab x:Name="Outfits" Visibility="Collapsed"/>
                            <userControls:CosmeticTab x:Name="Backblings" Visibility="Collapsed"/>
                            <userControls:CosmeticTab x:Name="Pickaxes"  Visibility="Collapsed"/>
                            <userControls:CosmeticTab x:Name="Emotes" Visibility="Collapsed"/>
                            <userControls:CosmeticTab x:Name="Gliders" Visibility="Collapsed"/>
                            <userControls:CosmeticTab x:Name="Wraps" Visibility="Collapsed"/>
                            <!--TODO <userControls:CosmeticTab x:Name="More" Visibility="Collapsed"/>-->
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
        </Border>
        <!-- End account -->
    </Grid>
</templates:BoundlessWindow>
