<templates:BoundlessWindow x:Class="Boundless.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boundless.Desktop"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wpf1="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
        xmlns:templates="clr-namespace:Boundless.Desktop.Templates"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:userControls="clr-namespace:Boundless.Desktop.UserControls"
        xmlns:tabs="clr-namespace:Boundless.Desktop.UserControls.Tabs"
        mc:Ignorable="d"
        Height="850" Width="1300"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        UseLayoutRounding="True"
        MinWidth="950"
        MinHeight="600"
        Title="Pro Launcher"
        Style="{StaticResource MyBoundlessWindowStyle}"
        Loaded="MainWindow_OnLoaded">
    <Grid Background="#090f19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="330"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="10"/>
        </Grid.RowDefinitions>
        
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <!-- Start account manager-->
            <Border Grid.Row="1" 
                    Margin="10 5" 
                    Background="#111729" 
                    CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="#202a47">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="55"/>
                    </Grid.RowDefinitions>
                    
                    <Grid Grid.Row="0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" 
                                   Text="ACCOUNTS"
                                   Foreground="#c9cddc"
                                   FontFamily="./Fonts/#Roboto" 
                                   FontWeight="600"
                                   VerticalAlignment="Center"
                                   Margin="5 0"/>
                        <Button Grid.Column="2" 
                                Width="30" 
                                Height="30" 
                                Padding="5"
                                Background="#111729"
                                BorderBrush="#202a47">
                            <StackPanel>
                                <ui:SymbolIcon Symbol="Add24" Filled="True" Foreground="#2e5ecc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    
                    <!-- Account entries -->
                    <ScrollViewer Grid.Row="1" Margin="0 5 0 0">
                        <StackPanel Name="AccountsPanel">
                            <TextBlock Name="NoAccountsFoundTextBlock"
                                       Text="No accounts found." 
                                       Foreground="#919191" 
                                       Margin="0 8"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <Grid Grid.Row="2">
                        <Button Height="40"
                                Margin="5 0"
                                Padding="0 -10"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Background="#111729"
                                BorderBrush="#202a47"
                                BorderThickness="2"
                                Click="LoadAccount_OnClick">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Add24" Filled="True" Foreground="#2e5ecc" Margin="5"/>
                                <TextBlock Text="Add Account" Margin="5" Foreground="#2e5ecc"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <!-- End account manager-->
            
            <Border Grid.Row="2" 
                    Margin="10 5" 
                    Background="#111729" 
                    CornerRadius="5"
                    BorderThickness="1"
                    BorderBrush="#202a47"
                    MinHeight="350">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition Height="80"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0">
                        <userControls:NavButton Icon="PlayCircle28" Text="Launch Fortnite" Margin="0 3"
                                                Click="LaunchFortnite_OnClick"/>
                        <userControls:NavButton Icon="Person24" Text="Cosmetics" Margin="0 3" IsActive="True"/>
                        <userControls:NavButton Icon="DataBarVertical24" Text="Stats" Margin="0 3"/>
                        <userControls:NavButton Icon="Settings28" Text="Settings" Margin="0 3"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        
    </Grid>
</templates:BoundlessWindow>
