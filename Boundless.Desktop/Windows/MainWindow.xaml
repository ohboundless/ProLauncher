<templates:BoundlessWindow x:Class="Boundless.Desktop.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Boundless.Desktop"
        xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:wpf1="http://schemas.microsoft.com/winfx/2006/xaml/presentation/blazor"
        xmlns:templates="clr-namespace:Boundless.Desktop.Templates"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:userControls="clr-namespace:Boundless.Desktop.UserControls"
        xmlns:tabs="clr-namespace:Boundless.Desktop.UserControls.Tabs"
        mc:Ignorable="d"
        Height="700" Width="1150"
        WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize"
        WindowStyle="None"
        BorderThickness="1"
        UseLayoutRounding="True"
        MinWidth="750"
        MinHeight="500"
        Title=""
        Style="{StaticResource MyBoundlessWindowStyle}"
        Loaded="MainWindow_OnLoaded">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush>
                <LinearGradientBrush.Transform>
                    <RotateTransform Angle="45"/>
                </LinearGradientBrush.Transform>
                <LinearGradientBrush.GradientStops>
                    <GradientStop Color="#111828" Offset=".1"/>
                    <GradientStop Color="#0e1628" Offset=".4"/>
                    <GradientStop Color="#040814" Offset=".9"/>
                </LinearGradientBrush.GradientStops>
            </LinearGradientBrush>
        </Grid.Background>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="80"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0" Background="#0a101d">
            <userControls:NavButton Label="News" Icon="News24" MouseUp="Home_OnClick"
                                    Width="50" Height="50"
                                    Margin="0 5"/>
            <userControls:NavButton Label="Library" Icon="Games24" MouseUp="Library_OnClick" 
                                    Width="50" Height="50"
                                    Margin="0 5"/>
            <userControls:NavButton Label="Plugins" Icon="PlugConnected24" MouseUp="Library_OnClick" 
                                    Width="50" Height="50"
                                    Margin="0 5"/>
        </StackPanel>
        
        <Border Grid.Column="1"
            d:DataContext="{d:DesignInstance }">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition/>
                    <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Row="1" Grid.Column="1" x:Name="Tabs">
                    <tabs:HomeTab x:Name="HomeTab"/>
                    <tabs:LibraryTab x:Name="LibraryTab"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</templates:BoundlessWindow>
