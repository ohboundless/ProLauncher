<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="9.0.120" />
      <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
      <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
      <PackageReference Include="RestSharp" Version="113.1.0" />
      <PackageReference Include="Serilog" Version="4.3.0" />
      <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
      <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
      <PackageReference Include="VirtualizingWrapPanel" Version="2.5.4" />
      <PackageReference Include="WPF-UI" Version="4.2.0" />
    </ItemGroup>

    <ItemGroup>
      <Page Update="Windows\MainWindow.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
      <Page Update="UserControls\Tabs\SwapperTab.xaml">
        <Generator>MSBuild:Compile</Generator>
        <XamlRuntime>Wpf</XamlRuntime>
        <SubType>Designer</SubType>
      </Page>
    </ItemGroup>

    <ItemGroup>
      <Resource Include="Images\Splash.bmp" />
      <Resource Include="Images\Icons\T_UI_UniversalXP_Icon_LevelUp_Standard_256.png" />
      <Resource Include="Images\Icons\T_UI_Nexus_FigmentPass_Default_L.png" />
      <Resource Include="Images\Icons\T_UI_Nexus_FigmentPass_L.png" />
      <Resource Include="Images\Icons\T-VBuck-64.png" />
      <None Remove="Images\Icons\T_Ui_Outfit_256.png" />
      <None Remove="Images\Icons\T_Ui_Outfit_256.png" />
      <Resource Include="Images\Icons\T_Ui_Outfit_256.png" />
    </ItemGroup>

    <ItemGroup>
        <Resource Include="Fonts\Roboto-Italic-VariableFont_wdth,wght.ttf" />
        <Resource Include="Fonts\Roboto-VariableFont_wdth,wght.ttf" />
    </ItemGroup>
</Project>
