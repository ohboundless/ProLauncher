<UserControl x:Class="Boundless.Desktop.UserControls.LibraryItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="400">
    <Grid Width="400" Height="200" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <ScaleTransform ScaleX="1" ScaleY="1"/>
        </Grid.RenderTransform>
        
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Trigger.EnterActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                        To="1.05" Duration="0:0:0.10"/>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                        To="1.05" Duration="0:0:0.10"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.EnterActions>

                        <Trigger.ExitActions>
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                        To="1" Duration="0:0:0.15"/>
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                        To="1" Duration="0:0:0.15"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </Trigger.ExitActions>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        
        <Border Grid.Column="0" 
                Grid.ColumnSpan="2" 
                Name="Border1"
                Background="#121212" CornerRadius="10"/>
        <Border Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="#2fffffff" BorderThickness="1" CornerRadius="10" Margin="-10"/>
        
        <Grid Grid.Column="0">
            <Grid.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=Border1}" />
            </Grid.OpacityMask>
            <Image Source="/Images/Splash.bmp" HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Stretch="UniformToFill" Name="Image"/>
        </Grid>
        
        <StackPanel Grid.Column="1" Margin="20">
            <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource Roboto}"
                       x:Name="GameName">Fortnite</TextBlock>
            <TextBlock Foreground="DarkGray" Width="200" FontSize="10" 
                       HorizontalAlignment="Left" TextWrapping="Wrap"
                       x:Name="GameVersion">++Fortnite+Release-39.51-CL-51287198-Windows</TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
