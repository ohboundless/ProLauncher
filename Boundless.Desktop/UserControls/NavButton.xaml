<UserControl x:Class="Boundless.Desktop.UserControls.NavButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="50" d:DesignWidth="280">
    <Button Name="_btn"
            Height="50"
            Margin="5 0"
            Padding="0 -10"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderBrush="#3a4377"
            BorderThickness="0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            
            <ui:SymbolIcon Name="_labelIcon" 
                           Grid.Column="0"
                           Symbol="Accessibility24" 
                           Filled="False" 
                           FontSize="20"
                           Foreground="#c9cddc" 
                           Margin="20 0"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            <TextBlock Name="_textBlock" 
                       Grid.Column="1"
                       Text="Add Account" 
                       Margin="5 0" 
                       Foreground="#c9cddc"
                       FontFamily="./Fonts/#Roboto" 
                       FontSize="16"
                       FontWeight="400"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"/>
        </Grid>
    </Button>
</UserControl>
