<UserControl x:Class="Boundless.Desktop.UserControls.AccountEntry"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             mc:Ignorable="d"
             d:DesignHeight="75" d:DesignWidth="250"
             Margin="0 2">
    <Border Name="Container"
            Background="#3a4377"
            BorderBrush="#333b6a"
            BorderThickness="1"
            CornerRadius="5"
            MouseUp="AccountEntry_OnClick">
        <Grid Margin="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="20"/>
            </Grid.ColumnDefinitions>
            
            <Grid Grid.Column="0" Width="60" Height="60">
                <Border CornerRadius="8" Background="#222123" Name="Border1">
                </Border>
                <StackPanel>
                    <Image
                           Name="AccountIcon"
                           Source="https://fortnite-api.com/images/cosmetics/br/character_sweetletter/smallicon.png"/>
                    <StackPanel.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=Border1}" />
                    </StackPanel.OpacityMask>
                    </StackPanel>
            </Grid>
            
            <Grid Grid.Column="1" Margin="10 0 0 0">
                <StackPanel Margin="0 15">
                    <TextBlock Name="AccountName"
                               Text="Account Name"
                               Foreground="#c9cddc"
                               FontFamily="./Fonts/#Roboto" 
                               FontWeight="500"/>
                    <TextBlock Name="LastPlayTime"
                               Text="Last launched 2d ago"
                               Foreground="#9799a3"
                               FontFamily="./Fonts/#Roboto" 
                               FontSize="10"
                               FontWeight="400"/>
                </StackPanel>
            </Grid>
            
            <TextBlock Grid.Column="2" 
                Text="..."
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="25"
                Foreground="White"
                MouseDown="More_OnMouseDown">
                <TextBlock.LayoutTransform>
                    <RotateTransform Angle="90"/>
                </TextBlock.LayoutTransform>
            </TextBlock>
        </Grid>
    </Border>
</UserControl>
