<UserControl x:Class="Boundless.Desktop.UserControls.CosmeticItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls"
             mc:Ignorable="d"
             Width="100" Height="115"
             Background="Transparent"
             Margin="5"
             Visibility="{Binding Visibility}"
             MouseUp="CosmeticItem_OnMouseUp">
    <Grid>
        <Border x:Name="MaskBorder"
                CornerRadius="10"
                Background="{Binding BackgroundRadial}" />
        
        <Image Source="{Binding IconSource}" 
               VerticalAlignment="Bottom"
               Width="100"
               Margin="1">
            <Image.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=MaskBorder}" />
            </Image.OpacityMask>
        </Image>
        
        <Border CornerRadius="10"
                BorderBrush="{Binding BorderColor}"
                BorderThickness="3"
                IsHitTestVisible="False"/>
    </Grid>
</UserControl>
