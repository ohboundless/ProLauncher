<UserControl x:Class="Boundless.Desktop.UserControls.CosmeticItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="145" d:DesignWidth="160"
             Background="Transparent"
             Margin="10 5">
    <Grid Width="100" Height="115">
        <Border Name="Border" CornerRadius="10"
                BorderBrush="#c29b2f"
                BorderThickness="3">
            <Border.Background>
                <RadialGradientBrush>
                    <RadialGradientBrush.GradientStops>
                        <GradientStop Color="#c29b2f" Offset=".5"/>
                        <GradientStop Color="#ba7632" Offset="1"/>
                    </RadialGradientBrush.GradientStops>
                </RadialGradientBrush>
            </Border.Background>
        </Border>
        
        <Image Name="Icon"
               Source="https://fortnite-api.com/images/cosmetics/br/character_sweetletter/icon.png" VerticalAlignment="Bottom"
               Width="100">
            <Image.OpacityMask>
                <VisualBrush Visual="{Binding ElementName=Border}" />
            </Image.OpacityMask>
        </Image>
    </Grid>
</UserControl>
