<UserControl x:Class="Boundless.Desktop.UserControls.Popups.SwapControlPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls.Popups"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:commands="clr-namespace:Boundless.Desktop.Commands"
             mc:Ignorable="d"
             d:DesignHeight="350" d:DesignWidth="800">
    <Border BorderBrush="#3a4377"
            BorderThickness="1"
            CornerRadius="10"
            Background="#202542">
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>
            
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>
            
            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="60"/>
                </Grid.RowDefinitions>
            
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>
                
                    <Image Source="../../Resources/Images/Icons/T_Ui_Outfit_256.png"
                           x:Name="SwapFromImage"/>
                
                    <ui:SymbolIcon Grid.Column="1" 
                                   Symbol="ArrowRight24"
                                   FontSize="60"
                                   Foreground="White"/>
                
                    <Image Grid.Column="2" 
                           Source="../../Resources/Images/Icons/T_Ui_Outfit_256.png"
                           x:Name="SwapToImage"/>

                </Grid>
            
                <StackPanel Grid.Row="2" 
                            Margin="10" 
                            HorizontalAlignment="Center">
                    <Button Content="Convert" Padding="20 10" Margin="2" Width="150"
                            Command="{x:Static commands:StaticCommands.ConvertSwapCommand}"
                            CommandParameter="{Binding}"/>
                    <Button Content="Revert" Padding="20 10" Margin="2" Width="150"
                            Command="{x:Static commands:StaticCommands.RevertSwapCommand}"
                            CommandParameter="{Binding}"/>
                </StackPanel>
            </Grid>
            
            <TextBox Grid.Column="1"
                     Grid.Row="0" 
                     Margin="10" 
                     x:Name="LogBox"
                     Width="300"/>
            
            <Button HorizontalAlignment="Right" 
                    Grid.ColumnSpan="2" 
                    Grid.Column="0"
                    Grid.Row="1"
                    Margin="20 0"
                    Content="Close"
                    Click="Close_OnClick"/>
        </Grid>
    </Border>
</UserControl>
