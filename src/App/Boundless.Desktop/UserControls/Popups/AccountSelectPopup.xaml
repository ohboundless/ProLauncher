<UserControl x:Class="Boundless.Desktop.UserControls.Popups.AccountSelectPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls.Popups"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:commands="clr-namespace:Boundless.Desktop.Commands"
             mc:Ignorable="d"
             Width="500" Height="280">
    <Border BorderBrush="#3a4377"
            BorderThickness="1"
            CornerRadius="10"
            Background="#202542">
        <Grid Margin="15">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="45"/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            
            <Button HorizontalAlignment="Right" Content="Close" Click="Close_OnClick"
                    Background="#04ffffff"
                    BorderBrush="#3a4377"
                    Padding="30 10"/>
            
            <StackPanel Grid.Row="1" Margin="15">
                <TextBlock Text="Select an Account for the Lobby Bot"
                           Foreground="White"
                           FontSize="20"
                           HorizontalAlignment="Center"/>
                
                <ComboBox Margin="20" Width="400" x:Name="Accounts"
                          Background="#04ffffff"
                          BorderBrush="#3a4377"/>
                
                <Button Content="Confirm" HorizontalAlignment="Center" Click="Confirm_OnClick"
                        Background="#04ffffff"
                        BorderBrush="#3a4377"
                        Padding="30 10"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
