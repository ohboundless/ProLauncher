<UserControl x:Class="Boundless.Desktop.UserControls.StringOption"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="300">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <TextBox Grid.Column="0" 
                     x:Name="TextBox" 
                     TextChanged="TextBox_OnTextChanged"
                     Height="40" MinWidth="300"/>
            
            <Button Grid.Column="1" 
                    x:Name="SelectDirBtn"
                    Content="..."
                    Margin="3"
                    Padding="20 9"
                    Click="SelectDirBtn_OnClick"/>
        </Grid>
        
        <StackPanel VerticalAlignment="Center" Margin="2 12">
            <TextBlock Text="Placeholder Name" Foreground="White" x:Name="OptionName"/>
            <TextBlock Text="Placeholder Description" 
                       Foreground="#bababa" 
                       FontSize="11"
                       x:Name="OptionDesc"/>
        </StackPanel>
    </StackPanel>
</UserControl>
