<UserControl x:Class="Boundless.Desktop.UserControls.Tabs.SelectSwapTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls.Tabs"
             xmlns:converters="clr-namespace:Boundless.Desktop.Utils.Converters"
             xmlns:viewModels="clr-namespace:Boundless.Desktop.ViewModels"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:userControls="clr-namespace:Boundless.Desktop.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="75"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    Margin="15">
            <Button Content="Back" 
                    Padding="20 10" 
                    Margin="10 0"
                    Click="Back_OnClick"/>
            <TextBlock Text="Select Cosmetic to Swap From" 
                       VerticalAlignment="Center" 
                       Margin="5 0"
                       Foreground="White"/>
        </StackPanel>
        
        <Border Grid.Row="1" VerticalAlignment="Top" BorderBrush="#202a47" BorderThickness="0 1 0 0"/>
        
        <!-- Search bar, filter, and sorting -->
        <Border Grid.Row="1" Background="#0f000000">
            <StackPanel Orientation="Horizontal" Margin="20 10" VerticalAlignment="Center">
                <!--TODO FIX TEXTBOX FOCUS STYLE-->
                <ui:TextBox PlaceholderText="Search cosmetics..." 
                            Width="265" BorderBrush="#202a47" 
                            BorderThickness="1"
                            Background="#0affffff"
                            FocusVisualStyle="{x:Null}"
                            IconPlacement="Right"
                            Text="{Binding ElementName=CosmeticPanel,
                                Path=CosmeticsViewModel.SearchText, 
                                UpdateSourceTrigger=PropertyChanged}">
                    <ui:TextBox.Icon>
                        <ui:SymbolIcon Symbol="Search24"/>
                    </ui:TextBox.Icon>
                </ui:TextBox>
                
                <Button Height="40" Padding="10 0" Margin="10 0">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Filter24"/>
                        <TextBlock Margin="5 0 0 0"
                                   FontSize="14"
                                   FontWeight="600">Filter</TextBlock>
                    </StackPanel>
                </Button>
                
                <ComboBox Height="40" ItemsSource="{Binding MyStringList}" 
                          ItemStringFormat="Sort By: {0}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Sort: " Foreground="White" />
                                <TextBlock Text="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                    
                    <ComboBoxItem Content="Default" 
                                  IsSelected="True"/>
                    <ComboBoxItem Content="Name"/>
                    <ComboBoxItem Content="Rarity"/>
                    <ComboBoxItem Content="Date Added"/>
                </ComboBox>
            </StackPanel>
        </Border>
            
        <Border Grid.Row="2" VerticalAlignment="Top" BorderBrush="#202a47" BorderThickness="0 1 0 0"/>
        
        <!-- Cosmetic tab panels -->
        <Grid Grid.Row="2" Margin="15 10">
            <ui:ProgressRing Name="CosmeticProgressRing" Foreground="#3a4377" 
                             Visibility="Collapsed"
                             Margin="0 0 0 50">
            </ui:ProgressRing>
            <userControls:SelectSwapPanel x:Name="CosmeticPanel"/>
        </Grid>
    </Grid>
</UserControl>
