<UserControl x:Class="Boundless.Desktop.UserControls.Tabs.SettingsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Boundless.Desktop.UserControls.Tabs"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <TextBlock Text="Settings" 
                   Foreground="White" 
                   FontSize="30"
                   Margin="15 0" VerticalAlignment="Center"/>
        
        <Border Grid.Row="1" VerticalAlignment="Top" BorderBrush="#202a47" BorderThickness="0 1 0 0"/>
        
        <StackPanel Grid.Row="1"
                    Margin="30"
                    x:Name="SettingsPanel">
            
        </StackPanel>
    </Grid>
</UserControl>
