<script>
    window.SetActive = function (id) {
        document.querySelectorAll(".active").forEach(x => {
            x.classList.remove("active");
        });
    
        let elm = document.querySelector(id);
        elm.classList.add("active");
    }
    
    function ToggleMenu() {
        let btn = document.querySelector("#sidebar-toggle");
        btn.classList.toggle("expanded");
        let isExpanded = btn.classList.contains("expanded");
        
        let spans = document.querySelectorAll(".nav-links li a span");
        spans.forEach(x => {
            x.style.display = isExpanded ? "block" : "";
            x.style.top = isExpanded ? "50%" : "";
            x.style.transform = isExpanded ? "translateY(-50%)" : "";
            x.style.left = isExpanded ? "50px" : "";
            x.style.position = isExpanded ? "absolute" : "";
        });

        let lis = document.querySelectorAll(".nav-links li");
        lis.forEach(x => {
            x.style.width = isExpanded ? "95%" : "";
            x.style.height = isExpanded ? "70px" : "";
        });

        let as = document.querySelectorAll(".nav-links li a");
        as.forEach(x => {
            x.style.width = isExpanded ? "100%" : "";
            x.style.height = isExpanded ? "60px" : "";
        });

        let svgs = document.querySelectorAll(".nav-links li svg");
        svgs.forEach(x => {
            x.style.left = isExpanded ? "20px" : "";
            x.style.top = isExpanded ? "50%" : "";
            x.style.transform = isExpanded ? "translateY(-50%)" : "";
            x.style.position = isExpanded ? "absolute" : "";
        });

        let sidebar = document.querySelector(".sidebar");
        sidebar.style.width = isExpanded ? "100%" : "";

        let nav = document.querySelector(".nav-links");
        nav.style.width = isExpanded ? "90%" : "";

        let status = document.querySelector(".login-status");
        status.style.height = isExpanded ? "100px" : "";
        
        let statusCtn = document.querySelector(".login-status div");
        statusCtn.style.position = isExpanded ? "relative" : "";
        statusCtn.style.width = isExpanded ? "100%" : "";

        let logoutBtn = document.querySelector(".login-status div button");
        logoutBtn.style.display = isExpanded ? "inline-block" : "";

        let loginMsg = document.querySelector(".login-status span");
        loginMsg.style.marginTop = isExpanded ? "10px" : "";
        loginMsg.style.display = isExpanded ? "inline-block" : "";
    }
</script>

@if (_showLogin)
{
    <LoginModal></LoginModal>
    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="white" class="bi bi-x-lg" viewBox="0 0 16 16" style="top: 20px; right: 20px; position: absolute; z-index:999; pointer-events: none;">
        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
    </svg>
    <div id="dropshadow" @onclick="() => _showLogin = false">
    </div>
}

@if (_showLogoutModal)
{
    <div class="modal-container">
        <p style="font-size: 18px; color: white;">Are you sure you want to sign out?</p>
        <div>
            <button @onclick="Logout" style="background: transparent; box-shadow: inset 0 0 0 1px #f54542; margin-top: 0; border: none; color: white; border-radius: 4px; padding: 8px 10px; font-size: 14px;">Yes I'm sure</button>
            <button @onclick="() => _showLogoutModal = false" style="background: transparent; box-shadow: inset 0 0 0 1px #0d6efd; margin-top: 0; border: none; color: white; border-radius: 4px; padding: 8px 10px; font-size: 14px;">No I don't wanna</button>
        </div>
    </div>
    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="white" class="bi bi-x-lg" viewBox="0 0 16 16" style="top: 20px; right: 80px; position: absolute; z-index:999; pointer-events: none;">
        <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8z"/>
    </svg>
    <div id="dropshadow" @onclick="() => _showLogoutModal = false">
    </div>
}

